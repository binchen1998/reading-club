# 可复制为 backend/.env，或使用仓库根目录 .env
# npm run deploy 会读取 backend/.env 与仓库根 .env

REDIS_URL=redis://127.0.0.1:6379/0
SQUARE_SNAPSHOT_REFRESH_INTERVAL_SECONDS=60

QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_CDN_DOMAIN=
QINIU_ZONE=z0
QINIU_REGION=z0
QINIU_PRACTICE_PREFIX=reading-club/practices
QINIU_ASSET_PREFIX=reading-club/assets
QINIU_FRONTEND_PREFIX=reading-club
QINIU_AVATAR_PREFIX=reading-club/avatars

ADMIN_USERNAME=admin
ADMIN_PASSWORD=coding61
# 昵称审核（DashScope / qwen-max）；不填则跳过审核
QWEN_API_KEY=
# 在线/预生成讲解走 luna，助教走 nano；必须配置 OPENAI_BASE_URL
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEACHING_MODEL=gpt-5.6-luna
OPENAI_ASSISTANT_MODEL=gpt-5.6-nano
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.6-luna

# 数据库：启动过程不建库建表，请先手工建好 MySQL 库，再跑迁移
# DB_TYPE=sqlite
# SQLITE_FILE=
DB_TYPE=mysql
MYSQL_URL=mysql+aiomysql://reading_club:password@localhost/reading_club?charset=utf8mb4
